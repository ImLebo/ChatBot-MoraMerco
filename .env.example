# Configuración general
NODE_ENV=development
SESSIONS_DIR=./sessions

# Visualización de grupos de WhatsApp (permite ver mensajes en consola sin responderles)
SHOW_GROUP_MESSAGES=true

# JID del grupo interno de WhatsApp para alertas automáticas de pedidos confirmados (Ventas/Operaciones)
WHATSAPP_SALES_GROUP_JID=120363413680170295@g.us

# Configuración de Gemini AI
# Prioridad 1: Modelo Principal
GEMINI_MODEL=gemini-3.1-flash-lite
# Prioridad 2: Modelo Secundario / Fallback (si el principal falla o se satura)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
